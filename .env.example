# =============================================================================
# Vault — Environment Variables
# Copy this file:  cp .env.example .env
# =============================================================================

# App URL (use your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# CLERK (Auth) — https://dashboard.clerk.com
# -----------------------------------------------------------------------------
# 1. Create a free application at https://dashboard.clerk.com
# 2. Go to: Configure → API Keys
# 3. Copy Publishable key and Secret key below
#
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Clerk route config (leave as-is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Webhook signing secret (for user sync to database)
# 1. Clerk Dashboard → Configure → Webhooks → Add Endpoint
# 2. URL: http://localhost:3000/api/webhooks/clerk  (use ngrok for local dev)
# 3. Events: user.created, user.updated, user.deleted
# 4. Copy the Signing Secret below
#
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxx

# -----------------------------------------------------------------------------
# SUPABASE (Database + Storage) — https://supabase.com/dashboard
# -----------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com/dashboard
# 2. Go to: Project Settings → API
# 3. Copy Project URL and anon public key
#
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-side only — never expose to client)
# Same page: Project Settings → API → service_role key
#
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Receipt storage bucket name (create in Supabase → Storage → New bucket: "receipts")
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=receipts

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string → URI
# Use "Transaction" pooler mode, port 6543 (recommended for serverless)
#
# Format:
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
